# Configuration locale du copilote.
# Copiez ce fichier en .env (ignoré par Git), puis adaptez les valeurs.
# Aucun secret ici : ce fichier est public.

# Adresse du serveur Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modèle de génération (changer de modèle = changer cette ligne)
LLM_MODEL=ministral-3:3b
# Taille du contexte en tokens (passages + question + réponse)
LLM_NUM_CTX=8192
# Nombre de couches du modèle placées sur la carte graphique : 99 = toutes (le plus rapide).
# Mesuré : ministral-3:3b avec 8192 tokens de contexte occupe 3,87 Go sur 4 Go.
# En cas d'erreur « out of memory » : baissez LLM_NUM_CTX (6144 ou 4096) ou LLM_NUM_GPU (par exemple 20),
# ou laissez LLM_NUM_GPU vide pour laisser Ollama choisir (environ 4 fois plus lent).
LLM_NUM_GPU=99
# Température basse : réponses plus stables et plus fidèles aux passages
LLM_TEMPERATURE=0.1
# Longueur maximale d'une réponse, en tokens (une réponse coupée est signalée)
LLM_MAX_TOKENS=700

# Modèle d'embeddings multilingue
EMBEDDING_MODEL=bge-m3

# Matériel utilisé pour les embeddings : gpu (carte graphique) ou cpu (processeur)
# - pour construire l'index :
INDEX_EMBEDDING_DEVICE=gpu
# - pour les questions : cpu, afin de laisser la carte graphique au modèle de génération
QUERY_EMBEDDING_DEVICE=cpu
