# Configuration locale du copilote.
# Copiez ce fichier en .env (ignoré par Git), puis adaptez les valeurs.
# Aucun secret ici : ce fichier est public.

# Adresse du serveur Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modèle de génération (changer de modèle = changer cette ligne)
LLM_MODEL=ministral-3:3b

# Modèle d'embeddings multilingue
EMBEDDING_MODEL=bge-m3

# Matériel utilisé pour les embeddings : gpu (carte graphique) ou cpu (processeur)
# - pour construire l'index :
INDEX_EMBEDDING_DEVICE=gpu
# - pour les questions : cpu, afin de laisser la carte graphique au modèle de génération
QUERY_EMBEDDING_DEVICE=cpu
